# Apache Configuration for Biru Payment Hub
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /pembayaran/

    # Security: Protect sensitive files and directories
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^database/(.*)\.sql$ - [F,L]
    RewriteRule ^(app|config|database|views)/ - [F,L]

    # Allow direct access to existing files & directories (e.g. assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else to index.php
    RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]
</IfModule>

# Disable directory browsing
Options -Indexes

# UTF-8 Encoding default
AddDefaultCharset UTF-8

